    private async Task HandlePayment()
    {
        try
        {
            Logger.LogInformation("=== HandlePayment Started ===");

            var amount = Total() + 50 + (Total() * 0.1M);
            Logger.LogInformation("Calculated Amount: {Amount}", amount);

            // 1️⃣ Create PaymentIntent
            var payment = await PaymentService.CreatePaymentAsync(amount);
            if (payment == null)
            {
                await JS.InvokeVoidAsync("showSwal", "error", "Failed", "Payment creation failed.");
                return;
            }

            Logger.LogInformation("Payment created ✅ ClientSecret: {ClientSecret}, PaymentId: {PaymentId}",
                payment.ClientSecret, payment.PaymentId);

            // 2️⃣ Verify payment
            var verify = await PaymentService.VerifyPaymentAsync(payment.PaymentId);

            if (verify?.Data?.Status == "succeeded")
            {
                // 3️⃣ Fetch token
                var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                // 4️⃣ Build Order Payload properly
                var shippingAddressId = 29; // TODO: Replace with selected shipping address Id
                var billingAddressId = sameAsShipping ? shippingAddressId : billingInfo.CityId; // FIX: Replace with billing address Id after saving

                var orderPayload = new
                {
                    payment_mode = "online",
                    paymentMethod = "pm_card_visa", // Stripe payment method ID
                    cart_id = cartItems.FirstOrDefault()?.Cart_Id ?? 0,
                    shipping_address_id = shippingAddressId,
                    billingSameAsShipping = sameAsShipping,
                    billing_address_id = billingAddressId
                };

                Logger.LogInformation("Order Payload: {@OrderPayload}", orderPayload);

                // 5️⃣ Call create-order API
                var orderResponse = await Http.PostAsJsonAsync("order/create-order", orderPayload);

                if (orderResponse.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("showSwal", "success", "Success", "Order placed successfully!");
                    Nav.NavigateTo("/order-success");
                }
                else
                {
                    var err = await orderResponse.Content.ReadAsStringAsync();
                    Logger.LogWarning("Order API failed: " + err);
                    await JS.InvokeVoidAsync("showSwal", "error", "Failed", "Order creation failed: " + err);
                }
            }
            else
            {
                await JS.InvokeVoidAsync("showSwal", "warning", "Warning", $"Payment verification failed: {verify?.Message}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "EXCEPTION in HandlePayment");
            await JS.InvokeVoidAsync("showSwal", "error", "Error", $"Payment error: {ex.Message}");
        }
    }



    private async Task HandleBillingAddress()
    {
        try
        {
            var payload = new
            {
                city_id = billingInfo.CityId,
                state_id = billingInfo.StateId,
                country_id = billingInfo.CountryId,
                name = billingInfo.Name,
                phone_number = billingInfo.PhoneNumber,
                address_line1 = billingInfo.AddressLine1,
                address_line2 = billingInfo.AddressLine2,
                postal_code = int.TryParse(billingInfo.PostalCode, out var code) ? code : 0
            };

            var res = await Http.PostAsJsonAsync("order/addAddress", payload);

            if (res.IsSuccessStatusCode)
            {
                Logger.LogInformation("Billing address saved successfully!");
                await JS.InvokeVoidAsync("showSwal", "success", "Success", "Billing address saved successfully!");
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to save billing address: " + err);
                await JS.InvokeVoidAsync("showSwal", "error", "Failed", "Error: " + err);
            }

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while saving billing address");
            await JS.InvokeVoidAsync("showSwal", "error", "Exception", ex.Message);
        }
    }
    private int CountryId
    {
        get => billingInfo.CountryId;
        set
        {
            if (billingInfo.CountryId != value)
            {
                billingInfo.CountryId = value;
                _ = LoadStatesAsync(value);
            }
        }
    }

    private int StateId
    {
        get => billingInfo.StateId;
        set
        {
            if (billingInfo.StateId != value)
            {
                billingInfo.StateId = value;
                _ = LoadCitiesAsync(value);
            }
        }
    }


    private async Task LoadStatesAsync(int countryId)
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResponse<List<State>>>($"listOfState/{countryId}");
            states = resp?.Data ?? new();
            cities.Clear();
            billingInfo.StateId = 0;
            billingInfo.CityId = 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching states");
            states.Clear();
            cities.Clear();
        }
        StateHasChanged();
    }

    private async Task LoadCitiesAsync(int stateId)
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResponse<List<City>>>($"listOfCity/{stateId}");
            cities = resp?.Data ?? new();
            billingInfo.CityId = 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching cities");
            cities.Clear();
        }
        StateHasChanged();
    }


    private decimal Total() =>
        cartItems?.Sum(i => (decimal)(i.ProductVariant?.Price ?? 0) * i.Quantity) ?? 0;

    public class StripeResult
    {
        public bool Success { get; set; }
        public string PaymentId { get; set; }
        public string Message { get; set; }
    }


    public class ShippingInfo
    {
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string AddressLine1 { get; set; }
        public string AddressLine2 { get; set; }
        public string City { get; set; }
        public string State { get; set; }
        public string PostalCode { get; set; }
        public string PhoneNumber { get; set; }
        public string Email { get; set; }
    }

    public class BillingInfo
    {
        public string Name { get; set; }
        public string AddressLine1 { get; set; }
        public string AddressLine2 { get; set; }
        public string PostalCode { get; set; }
        public string PhoneNumber { get; set; }
        public int CountryId { get; set; }
        public int StateId { get; set; }
        public int CityId { get; set; }
    }

    public class CartResponse
    {
        public int Id { get; set; }
        public int User_Id { get; set; }
        public int Total_Quantity { get; set; }
        public decimal Sub_Total { get; set; }
        public decimal Total_Price { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("cart_items")]
        public List<CartItem> CartItems { get; set; }
    }

    public class CartItem
    {
        public int Id { get; set; }
        public int Product_Id { get; set; }
        public int Product_Variant_Id { get; set; }
        public int Cart_Id { get; set; }
        public int Quantity { get; set; }
        public decimal Price_Total { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("productVariant")]
        public ProductVariant ProductVariant { get; set; }
    }

    public class ProductVariant
    {
        [System.Text.Json.Serialization.JsonPropertyName("product_title_name")]
        public string ProductTitleName { get; set; }
        public int Product_Id { get; set; }
        public string Description { get; set; }
        public string Color { get; set; }
        public string Size { get; set; }
        public decimal Price { get; set; }
        public ProductImage Image { get; set; }
    }

    public class ProductImage
    {
        [System.Text.Json.Serialization.JsonPropertyName("image_path")]
        public string ImagePath { get; set; }
    }

    public class ApiResponse<T>
    {
        public int StatusCode { get; set; }
        public string Status { get; set; }
        public T Data { get; set; }
    }

    public class AddressResponse
    {
        public int Id { get; set; }
        public int User_Id { get; set; }
        public int Country_Id { get; set; }
        public int State_Id { get; set; }
        public int City_Id { get; set; }
        public string Name { get; set; }
        public string Phone_Number { get; set; }
        public int Postal_Code { get; set; }
        public string Label { get; set; }
        public string Address_Line1 { get; set; }
        public string Address_Line2 { get; set; }
        public bool Home_Address { get; set; }
        public City City { get; set; }
        public State State { get; set; }
        public Country Country { get; set; }
    }

    public class City { public int Id { get; set; } public string City_Name { get; set; } }
    public class State { public int Id { get; set; } public string State_Name { get; set; } }
    public class Country { public int Id { get; set; } public string Country_Name { get; set; } }

    public class VerifyPaymentResponse
    {
        public int StatusCode { get; set; }
        public string Status { get; set; }
        public string Message { get; set; }
        public VerifyPaymentData Data { get; set; }
    }

    public class VerifyPaymentData
    {
        public string Status { get; set; }   
        public int Amount { get; set; }
        public string Currency { get; set; }
        public string PaymentMethod { get; set; }
    }

