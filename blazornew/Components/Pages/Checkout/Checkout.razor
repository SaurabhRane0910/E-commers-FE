@page "/checkout"
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILogger<Checkout> Logger
@inject NavigationManager Nav
@inject blazornew.Service.PaymentService PaymentService

<Header />

<div class="container mt-4">
    <div class="row">

        <!-- Shipping Information -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <h4 class="mb-2 m-lg-4">Shipping Information</h4>
                <div class="card-body">
                    <EditForm Model="@shippingInfo">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>First Name</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.FirstName" placeholder="First Name" disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Last Name</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.LastName" placeholder="Last Name"  disabled />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label>Address Line 1</label>
                            <InputText class="form-control" @bind-Value="shippingInfo.AddressLine1" placeholder="Address Line 1" disabled />
                        </div>
                        <div class="mb-3">
                            <label>Address Line 2 (Optional)</label>
                            <InputText class="form-control" @bind-Value="shippingInfo.AddressLine2" placeholder="Address Line 2 (Optional)" disabled />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>City</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.City" placeholder="City" disabled />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label>State</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.State" placeholder="State" disabled />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label>Zip Code</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.PostalCode" placeholder="Zip Code" disabled />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Phone Number</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.PhoneNumber" placeholder="Phone Number" disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="shippingInfo.Email" placeholder="Email Address" disabled />
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Billing Address -->
            <!-- ✅ Billing Address -->
            <div class="card shadow-sm mb-4">
                <h4 class="mb-2 m-lg-4">Billing Address</h4>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <InputCheckbox @bind-Value="sameAsShipping" class="form-check-input" id="sameAsShipping" />
                        <label class="form-check-label" for="sameAsShipping">Same as shipping address</label>
                    </div>

                    @if (!sameAsShipping)
                    {
                        <EditForm Model="@billingInfo" OnValidSubmit="HandleBillingAddress">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label>Full Name</label>
                                <InputText class="form-control" @bind-Value="billingInfo.Name" placeholder="Full Name" />
                            </div>

                            <div class="mb-3">
                                <label>Address Line 1</label>
                                <InputText class="form-control" @bind-Value="billingInfo.AddressLine1" />
                            </div>
                            <div class="mb-3">
                                <label>Address Line 2</label>
                                <InputText class="form-control" @bind-Value="billingInfo.AddressLine2" />
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label>Country</label>
                                    <InputSelect class="form-control" @bind-Value="CountryId">
                                        <option value="">-- Select Country --</option>
                                        @foreach (var c in countries)
                                        {
                                            <option value="@c.Id">@c.Country_Name</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label>State</label>
                                    <InputSelect class="form-control" @bind-Value="StateId" disabled="@(!states.Any())">
                                        <option value="">-- Select State --</option>
                                        @foreach (var s in states)
                                        {
                                            <option value="@s.Id">@s.State_Name</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label>City</label>
                                    <InputSelect class="form-control" @bind-Value="billingInfo.CityId" disabled="@(!cities.Any())">
                                        <option value="">-- Select City --</option>
                                        @foreach (var city in cities)
                                        {
                                            <option value="@city.Id">@city.City_Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label>Zip Code</label>
                                    <InputText class="form-control" @bind-Value="billingInfo.PostalCode" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Phone</label>
                                    <InputText class="form-control" @bind-Value="billingInfo.PhoneNumber" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Save Billing Address</button>
                        </EditForm>
                    }
                </div>
            </div>


           
            <div class="card shadow-sm mb-4">
                <h4 class="mb-2 m-lg-4">Payment Information</h4>
                <div class="card-body">
                    
                    <div id="card-element" class="form-control mb-3"></div>

                    <button class="btn btn-success w-100" @onclick="HandlePayment">
                        Pay ₹@((Total() + 50 + (Total() * 0.1M)).ToString("0.00"))
                    </button>
                </div>
            </div>

        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Order Summary</h5>

                    @if (cartItems == null)
                    {
                        <p>Loading order summary...</p>
                    }
                    else if (!cartItems.Any())
                    {
                        <p>Your cart is empty.</p>
                    }
                    else
                    {
                        @foreach (var item in cartItems)
                        {
                            <div class="d-flex align-items-center mb-3">
                                <img src="@GetImageUrl(item.ProductVariant?.Image?.ImagePath)"
                                     alt="@item.ProductVariant?.ProductTitleName"
                                     style="width: 60px; height: 60px; object-fit: cover; margin-right: 12px; border-radius: 6px;"
                                     onerror="this.onerror=null;this.src='/bootstrap/lock.jpg';" />

                                <div class="flex-grow-1">
                                    <div class="fw-bold">@item.ProductVariant?.ProductTitleName</div>
                                    <small class="text-muted">Qty: @item.Quantity</small>
                                </div>

                                <div class="fw-bold text-end">
                                    ₹@((item.ProductVariant?.Price ?? 0) * item.Quantity)
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>₹@Total().ToString("0.00")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span>₹50.00</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax:</span>
                            <span>₹@((Total() * 0.1M).ToString("0.00"))</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between fw-bold mb-3">
                            <span>Total:</span>
                            <span>₹@((Total() + 50 + (Total() * 0.1M)).ToString("0.00"))</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<Footer />

@code {
    private ShippingInfo shippingInfo = new();
    private BillingInfo billingInfo = new();
    private bool sameAsShipping = true;

    private List<CartItem> cartItems;
    private bool _isInitialized = false;

    private List<Country> countries = new();
    private List<State> states = new();
    private List<City> cities = new();

    private string GetImageUrl(string imageName)
    {
        if (string.IsNullOrWhiteSpace(imageName))
            return "/bootstrap/lock.jpg";
        return $"https://ecomm-intern-demo.onrender.com/uploads/{imageName}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
            await LoadCart();
            await LoadDefaultAddress();
            await LoadCountries();

         
            await JS.InvokeVoidAsync("initStripe", "pk_test_51RA8LnQ1EiiVbzWauH7zygZgAq8IpUmHoIeZ1SE47PsNO8agBsB1ptSejTQbBOnVltIhC3T5IECCjxxR8PdbjnpB007QHKCHfc");

            StateHasChanged();
        }
    }

    private async Task LoadCart()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                Logger.LogWarning("No auth token found.");
                Nav.NavigateTo("/login");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetFromJsonAsync<ApiResponse<CartResponse>>("cart/viewCart");
            cartItems = response?.Data?.CartItems ?? new List<CartItem>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cart");
            cartItems = new List<CartItem>();
        }
    }

    private async Task LoadDefaultAddress()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<List<AddressResponse>>>("order/listOfAddress");
            var addresses = response?.Data ?? new List<AddressResponse>();

            if (addresses.Any())
            {
                var addr = addresses.First();
                shippingInfo.FirstName = addr.Name?.Split(' ').FirstOrDefault() ?? "";
                shippingInfo.LastName = addr.Name?.Split(' ').Skip(1).FirstOrDefault() ?? "";
                shippingInfo.AddressLine1 = addr.Address_Line1;
                shippingInfo.AddressLine2 = addr.Address_Line2;
                shippingInfo.City = addr.City?.City_Name;
                shippingInfo.State = addr.State?.State_Name;
                shippingInfo.PostalCode = addr.Postal_Code.ToString();
                shippingInfo.PhoneNumber = addr.Phone_Number;
                shippingInfo.Email = "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching default address");
        }
    }

    private async Task LoadCountries()
    {
        var resp = await Http.GetFromJsonAsync<ApiResponse<List<Country>>>("listOfCountry");
        countries = resp?.Data ?? new();
    }

    private async Task LoadStates(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var countryId))
        {
            var resp = await Http.GetFromJsonAsync<ApiResponse<List<State>>>($"listOfState/{countryId}");
            states = resp?.Data ?? new();
            cities.Clear();
        }
    }

    private async Task LoadCities(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var stateId))
        {
            var resp = await Http.GetFromJsonAsync<ApiResponse<List<City>>>($"listOfCity/{stateId}");
            cities = resp?.Data ?? new();
        }
    }
