@page "/forgot-password"
@inject HttpClient Http 
@inject NavigationManager Navigation

@inject IJSRuntime JS

<div class="container myContain">
    <div class="row">

        <div class="forgot-password">
            <span> Forgot your</span> <br>
            <span> password?</span>
        </div>

        <div class="inputMain">
            <h6 class="text-right"> Account email address</h6>
            <input type="email" @bind="email" placeholder="your-sign-up-email@example.com" class="form-control" />
        </div>

        <div class="submitBtn">
            <button class="btn sign-in-btn btn-primary" @onclick="RequestPasswordReset">
                Request password reset
            </button>
        </div>

        <div class="backPage">
            <a href="/login"> Back to login</a>
        </div>

    </div>
</div>

@code {
    private string email { get; set; } = "";

    private async Task RequestPasswordReset()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", "Please enter your email", "error");
            return;
        }

        var payload = new { email = email };
        var response = await Http.PostAsJsonAsync("https://ecomm-intern-demo.onrender.com/api/user/verifyEmail", payload);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ApiResponse>();

            if (result?.statusCode == 200)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Success", result.message, "success");

                // Redirect after showing success
                Navigation.NavigateTo("/reset-password");
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", result?.message ?? "Something went wrong", "error");
            }
        }
        else
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", "Server error occurred", "error");
        }
    }

    public class ApiResponse
    {
        public int statusCode { get; set; }
        public string status { get; set; }
        public string message { get; set; }
    }
}
