@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container myContain">
    <div class="row">

        <div class="forgot-password">
            <span> Reset</span> <br>
            <span> your password</span>
        </div>

        <!-- Email -->
        <div class="inputMain">
            <h6 class="text-right"> Email Address</h6>
            <input type="email" @bind="model.email" placeholder="your-sign-up-email@example.com" class="form-control" />
        </div>

        <!-- OTP -->
        <div class="inputMain">
            <h6 class="text-right"> Enter OTP</h6>
            <input type="number" @bind="model.otp" placeholder="Enter the OTP sent to your email" class="form-control" />
        </div>

        <!-- New Password -->
        <div class="inputMain">
            <h6 class="text-right"> New Password</h6>
            <input type="password" @bind="model.newPassword" placeholder="Enter new password" class="form-control" />
        </div>

        <!-- Confirm Password -->
        <div class="inputMain">
            <h6 class="text-right"> Confirm Password</h6>
            <input type="password" @bind="model.confirmPassword" placeholder="Confirm new password" class="form-control" />
        </div>

        <!-- Button -->
        <div class="submitBtn">
            <button class="btn sign-in-btn btn-primary" @onclick="UpdatePassword">
                Change Password
            </button>
        </div>

        <div class="backPage">
            <a href="/login"> Back to login</a>
        </div>

    </div>
</div>

@code {
    private ResetPasswordRequest model = new();

    private async Task UpdatePassword()
    {
        if (string.IsNullOrWhiteSpace(model.email) ||
            string.IsNullOrWhiteSpace(model.newPassword) ||
            string.IsNullOrWhiteSpace(model.confirmPassword) ||
            model.otp <= 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", "Please fill in all fields", "error");
            return;
        }

        var response = await Http.PostAsJsonAsync("https://ecomm-intern-demo.onrender.com/api/updatePassword", model);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ApiResponse>();

            if (result?.statusCode == 200)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Success", result.message, "success");
                Navigation.NavigateTo("/login");
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", "Error", result?.message ?? "Something went wrong", "error");
            }
        }
        else
        {
            var errorText = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("Swal.fire", "Error", $"({response.StatusCode}) {errorText}", "error");
        }
    }


    public class ResetPasswordRequest
    {
        public int otp { get; set; }
        public string newPassword { get; set; }
        public string confirmPassword { get; set; }
        public string email { get; set; }
    }

    public class ApiResponse
    {
        public int statusCode { get; set; }
        public string status { get; set; }
        public string message { get; set; }
    }
}
