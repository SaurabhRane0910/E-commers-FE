@page "/reset-password"
@using blazornew.Model
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISignupService signupService
@inject IJSRuntime JS

<div class="container myContain">
    <div class="row">
        <div class="bordeLine">


        <div class="forgot-password">
            <span class="line">Reset</span>
            <span class="line">your password</span>
        </div>

        <div class="centerReset">
            <div class="inputMain">
                <h6 class="text-right"> Email Address</h6>
                <input type="email" @bind="model.Email" placeholder="your-sign-up-email@example.com" class="form-control" />
            </div>

            <div class="inputMain">
                <h6 class="text-right"> Enter OTP</h6>
                <input type="number" @bind="model.Otp" placeholder="Enter the OTP sent to your email" class="form-control" />
            </div>

            <div class="inputMain">
                <h6 class="text-right"> New Password</h6>
                <input type="password" @bind="model.NewPassword" placeholder="Enter new password" class="form-control" />
            </div>

            <div class="inputMain">
                <h6 class="text-right"> Confirm Password</h6>
                <input type="password" @bind="model.ConfirmPassword" placeholder="Confirm new password" class="form-control" />
            </div>

            <div class="submitBtn">
                <button class="btn sign-in-btn btn-primary" @onclick="UpdatePassword">
                    Change Password
                </button>
            </div>

            <div class="backPage">
                <a href="/login"> Back to login</a>
            </div>

            </div>
        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest model = new();

    private async Task UpdatePassword()
    {
        if (string.IsNullOrWhiteSpace(model.Email) ||
            string.IsNullOrWhiteSpace(model.NewPassword) ||
            string.IsNullOrWhiteSpace(model.ConfirmPassword) ||
            model.Otp <= 0)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", "Please fill in all fields", "error");
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", "Passwords do not match", "error");
            return;
        }

        
        var response = await signupService.ResetPasswordAsync(model);

        if (response.Success)
        {
            await JS.InvokeVoidAsync("Swal.fire", "Success", response.Message ?? "Password updated successfully!", "success");
            Navigation.NavigateTo("/login");
        }
        else
        {
            await JS.InvokeVoidAsync("Swal.fire", "Error", response.Message ?? "Failed to reset password", "error");
        }
    }

}

